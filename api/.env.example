# Environment Configuration
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
APP_STAGE=dev
PORT=3000

# Database (PostgreSQL connection string)
# Example: postgresql://user:password@localhost:5432/issue_tracker
# Or use a cloud provider like Neon: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/issue_tracker

# JWT Authentication
# Must be at least 32 characters long — use a random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12
